# Streamlit Secrets Configuration for AI Features
# ===============================================

# OpenAI API Key for LLM recommendations
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY = "your-openai-api-key-here"

# Optional: Custom OpenAI model
OPENAI_MODEL = "gpt-3.5-turbo"

# Optional: Custom temperature for AI responses (0.0 to 1.0)
OPENAI_TEMPERATURE = 0.7

# Optional: Maximum tokens for AI responses
OPENAI_MAX_TOKENS = 500

# Database configuration (for multi-user features)
DATABASE_URL = "postgresql://user:password@localhost:5432/greenai"

# Redis configuration (for caching)
REDIS_URL = "redis://localhost:6379"

# Email configuration (for notifications)
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "your-email@gmail.com"
SMTP_PASSWORD = "your-app-password"

# Slack integration (for notifications)
SLACK_WEBHOOK_URL = "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"

# Discord integration (for notifications)
DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK"

# Cloud provider API keys (optional)
AWS_ACCESS_KEY_ID = "your-aws-access-key"
AWS_SECRET_ACCESS_KEY = "your-aws-secret-key"
AWS_REGION = "us-west-2"

GCP_PROJECT_ID = "your-gcp-project-id"
GCP_CREDENTIALS_PATH = "/path/to/gcp-credentials.json"

AZURE_SUBSCRIPTION_ID = "your-azure-subscription-id"
AZURE_CLIENT_ID = "your-azure-client-id"
AZURE_CLIENT_SECRET = "your-azure-client-secret"
AZURE_TENANT_ID = "your-azure-tenant-id"
